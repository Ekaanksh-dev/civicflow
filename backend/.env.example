# LLM Service configuration (Nvidia / OpenAI-compatible API)
ANTHROPIC_BASE_URL=https://integrate.api.nvidia.com/v1
ANTHROPIC_MODEL=mistralai/mistral-small-4-119b-2603
ANTHROPIC_API_KEY=your_nvidia_api_key_here

# MongoDB connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.8xny7wn.mongodb.net/civicflow?retryWrites=true&w=majority

# Email Service configuration (Gmail SMTP)
EMAIL_ADDRESS=your_email@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password
